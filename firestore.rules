rules_version = '2';

// Правила Firestore для WesiOS.
//
// Три вещи, на которых легко ошибиться:
//   1. Каждый match обязан лежать ВНУТРИ service — иначе не применяется вовсе.
//   2. Правила складываются по «ИЛИ». Отдельный `allow write: if false`
//      ничего не запрещает; исключение нужно повторять во всех правилах,
//      которые могут совпасть с тем же документом.
//   3. `{x=**}` даёт путь, а не строку: сравнение `x != 'имя'` не сработает.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Допуск к ключам: документ admins/<UID>. Добавить человека — создать
    // документ, а не править правила.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- данные пользователя

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // account, data, lastForecast
    match /users/{uid}/finance/{docId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && docId != 'lastForecast';
    }

    // data/whatIfScenarios/{id}, data/transactions/{id} и глубже.
    // Исключение повторено намеренно — см. пункт 2 в шапке.
    match /users/{uid}/finance/{docId}/{sub=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && docId != 'lastForecast';
    }

    // Общего правила `match /users/{uid}/{document=**}` здесь нет намеренно:
    // оно перекрыло бы finance и по «или» отменило запрет на lastForecast.

    // ---- ключи от внешних сервисов

    match /secrets/{document=**} {
      allow read, write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;  // только руками в консоли
    }

    // ---- по умолчанию запрещено всё

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
