# Public deployment target discovered in the WesiOS repository.
# No secret values are stored here.
WESI_AERO_TARGET_HOST=wesi-ai-178-236-247-194.nip.io
WESI_AERO_TARGET_IP=178.236.247.194

# Existing services on this VPS. Do not bind Wesi Aero over these ports.
WESI_AI_HTTPS_PORT=443
WESI_AI_RELAY_LOOPBACK_PORT=8787
WESI_AI_STREAM_LOOPBACK_PORT=8792

# Proposed non-conflicting Wesi Aero ports; open them only during deployment.
WESI_AERO_PORT=8790
WESI_AERO_REALITY_PORT=8443
WESI_AERO_AMNEZIAWG_PORT=51820

# Resolve these through a deployment secret manager. Values intentionally absent.
WESI_RELAY_SSH_USER=
WESI_RELAY_SSH_KEY=
WESI_RELAY_SSH_KNOWN_HOSTS=
WESI_AERO_ADMIN_TOKEN=
