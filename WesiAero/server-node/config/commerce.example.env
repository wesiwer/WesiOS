# Generate independent random values of at least 32 characters.
WESI_AERO_ADMIN_TOKEN=replace-with-random-admin-token
WESI_AERO_MASTER_KEY=replace-with-independent-random-master-key

# Public HTTPS URL of the reverse proxy in front of control plane.
WESI_AERO_PUBLIC_BASE_URL=https://gateway.example.com
WESI_AERO_PAYMENT_RETURN_URL=https://example.com/wesi-aero/payment-return

# Keep mock payments disabled in production.
WESI_AERO_ALLOW_MOCK_PAYMENTS=false

# YooKassa / SBP. Secrets stay on the server.
WESI_AERO_YOOKASSA_SHOP_ID=
WESI_AERO_YOOKASSA_SECRET_KEY=

# Crypto Pay. Start on testnet and switch only after acceptance tests.
WESI_AERO_CRYPTO_PAY_TOKEN=
WESI_AERO_CRYPTO_PAY_TESTNET=true
