{
  "log": {
    "access": "none",
    "dnsLog": false,
    "loglevel": "warning"
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "inbounds": [
    {
      "tag": "vless-reality",
      "listen": "0.0.0.0",
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "REPLACE_WITH_VLESS_USER_UUID",
            "email": "wesi-vless",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "AUTHORIZED_TLS_TARGET:443",
          "xver": 0,
          "serverNames": [
            "AUTHORIZED_TLS_TARGET"
          ],
          "privateKey": "REPLACE_WITH_REALITY_PRIVATE_KEY",
          "shortIds": [
            "REPLACE_WITH_HEX_SHORT_ID"
          ]
        }
      }
    },
    {
      "tag": "vmess-xray",
      "listen": "0.0.0.0",
      "port": 8444,
      "protocol": "vmess",
      "settings": {
        "clients": [
          {
            "id": "REPLACE_WITH_VMESS_USER_UUID",
            "email": "wesi-vmess",
            "alterId": 0
          }
        ]
      },
      "streamSettings": {
        "network": "raw",
        "security": "none"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ]
}
