rules_version = '2';

// Правила доступа к ключам WesiOS.
//
// Куда вставлять: консоль Firebase → Firestore Database → вкладка «Правила»
// → заменить содержимое этим файлом → «Опубликовать». Никакого сервера
// арендовать не нужно: правила выполняет инфраструктура Google.
//
// Почему проверка здесь, а не в приложении: приложение можно распаковать и
// переписать, а правила — нет. Всё, что решает приложение, решает и тот, у
// кого оно есть; всё, что решают правила, решает только Google.
service cloud.firestore {
  match /databases/{database}/documents {

    // Список тех, кому разрешено видеть ключи.
    //
    // Один документ на человека, имя документа — его UID. Добавить коллегу
    // значит создать документ, а не переписывать и заново публиковать
    // правила: правки правил легко забыть, а забытая правка тут означает
    // либо потерю доступа, либо лишний доступ.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Сами ключи. Ни читать, ни писать нельзя никому, кроме админов.
    match /secrets/{document=**} {
      allow read, write: if isAdmin();
    }

    // Свою запись в списке админов человек видеть может — приложению нужно
    // понимать, показывать ли раздел с ключами. Чужие — нет: перечень
    // сотрудников с доступом сам по себе полезен тому, кто ищет, кого
    // взламывать.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Записи создаются только руками в консоли Firebase. Иначе первый же
      // вошедший смог бы назначить админом себя, и весь список потерял бы
      // смысл.
      allow write: if false;
    }

    // Всё остальное закрыто. Правило по умолчанию должно быть «нельзя»:
    // забытая коллекция тогда просто не работает, а не утекает.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
