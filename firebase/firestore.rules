rules_version = '2';

// Правила доступа Firestore для WesiOS.
//
// Куда вставлять: консоль Firebase → Firestore Database → «Правила» →
// выделить всё, вставить этот файл целиком → «Опубликовать». Сервер
// арендовать не нужно: правила выполняет инфраструктура Google.
//
// Почему проверка здесь, а не в приложении: приложение можно распаковать и
// переписать, а правила — нет. Всё, что решает приложение, решает и тот, у
// кого оно есть; всё, что решают правила, решает только Google.
//
// ---------------------------------------------------------------------------
// ГЛАВНОЕ, ЧТО НАДО ЗНАТЬ, ПРАВЯ ЭТОТ ФАЙЛ
//
// 1. Каждый match обязан лежать ВНУТРИ блока service. Вынесенный за
//    закрывающую скобку блок не применяется вовсе — и тогда работает только
//    запрет по умолчанию, то есть закрыто всё.
//
// 2. Правила складываются по «ИЛИ». Если хоть одно правило разрешило —
//    доступ есть. Отдельный блок с `allow write: if false` НИЧЕГО не
//    запрещает: он просто не добавляет разрешения. Значит любое исключение
//    нужно повторять во ВСЕХ правилах, которые могут совпасть с тем же
//    документом, — иначе оно молча не действует.
//
// 3. При шаблоне `{x=**}` переменная имеет тип «путь», а не строку.
//    Сравнение `x != "lastForecast"` не совпадёт никогда, то есть условие
//    всегда истинно и ограничение бесполезно. Для сравнения с именем нужен
//    одиночный сегмент `{x}`.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Кто допущен к ключам: один документ на человека, имя документа — UID.
    // Добавить коллегу значит создать документ, а не переписывать и заново
    // публиковать правила: забытая правка правил означает либо потерю
    // доступа, либо лишний доступ.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- личные данные пользователя

    // Сам документ профиля.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Документы прямо под finance: account, data, lastForecast.
    match /users/{uid}/finance/{docId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && docId != 'lastForecast';
    }

    // Всё, что глубже: finance/data/whatIfScenarios/{id},
    // finance/data/transactions/{id} и прочее.
    //
    // Исключение для lastForecast повторено здесь НАМЕРЕННО. Неясно, ловит
    // ли `{sub=**}` ноль сегментов, то есть сам документ finance/lastForecast.
    // Если ловит — без этой проверки правило выше было бы отменено по «или».
    // Дублирование условия дешевле, чем зависимость от тонкости, которую
    // легко прочитать неправильно.
    match /users/{uid}/finance/{docId}/{sub=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && docId != 'lastForecast';
    }

    // Здесь СОЗНАТЕЛЬНО нет правила вида
    //     match /users/{uid}/{document=**} { allow read, write: ... }
    // Оно выглядит удобным, но перекрывает finance целиком и по «или»
    // отменяет запрет на запись lastForecast. Появится новая коллекция у
    // пользователя — для неё добавляется своё правило; до тех пор она просто
    // не работает, а не открыта всем.

    // ---- ключи от внешних сервисов

    match /secrets/{document=**} {
      allow read, write: if isAdmin();
    }

    // Свою запись в списке админов человек читать может — приложению нужно
    // понимать, показывать ли раздел с ключами. Чужие нет: перечень людей с
    // доступом сам по себе полезен тому, кто ищет, кого взламывать.
    match /admins/{uid} {
      allow read: if isOwner(uid);

      // Записи создаются только руками в консоли. Иначе первый же вошедший
      // назначил бы админом себя, и список потерял бы смысл.
      allow write: if false;
    }

    // ---- всё остальное

    // Правило по умолчанию — «нельзя»: забытая коллекция тогда просто не
    // работает, а не утекает.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
