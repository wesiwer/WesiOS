rules_version = '2';

// Правила доступа Firestore для WesiOS.
//
// Куда вставлять: консоль Firebase → Firestore Database → «Правила» →
// заменить содержимое целиком → «Опубликовать». Сервер арендовать не нужно:
// правила выполняет инфраструктура Google.
//
// Почему проверка здесь, а не в приложении: приложение можно распаковать и
// переписать, а правила — нет. Всё, что решает приложение, решает и тот, у
// кого оно есть; всё, что решают правила, решает только Google.
service cloud.firestore {
  match /databases/{database}/documents {

    // ВАЖНО ПРО СКОБКИ. Каждый match обязан находиться ВНУТРИ этого блока.
    // Блок, вынесенный за закрывающую скобку, не применяется вовсе — и тогда
    // работает только запрет по умолчанию внизу, то есть закрыто всё.

    // ---- кто допущен к ключам

    // Список допущенных: один документ на человека, имя документа — его UID.
    // Добавить коллегу значит создать документ, а не переписывать и заново
    // публиковать правила: забытая правка правил означает либо потерю
    // доступа, либо лишний доступ.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- личные данные пользователя

    // Каждый видит только своё поддерево. Здесь ОДИН сегмент ({docId}, а не
    // {docId=**}) намеренно: при рекурсивном шаблоне переменная имеет тип
    // «путь», а не строку, и сравнение вида `document != "lastForecast"`
    // выглядит работающим, но путь со строкой не совпадёт никогда — то есть
    // ограничение молча не сработает.
    match /users/{uid}/finance/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // lastForecast только читается: его пишет расчёт, а не пользователь.
      //
      // Исключение стоит внутри условия, а не отдельным блоком с
      // `allow write: if false`. Это принципиально: правила Firestore
      // складываются по «или», и отдельный запрещающий блок НЕ отменил бы
      // разрешение из другого блока — он просто ничего бы не изменил.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && docId != 'lastForecast';
    }

    // Вложенные коллекции внутри finance, если появятся: чтение своё,
    // запись своя. Отдельным правилом, потому что предыдущее ловит только
    // один сегмент.
    match /users/{uid}/finance/{docId}/{sub=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Всё остальное в своём профиле.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- ключи от внешних сервисов

    match /secrets/{document=**} {
      allow read, write: if isAdmin();
    }

    // Свою запись в списке админов человек читать может — приложению нужно
    // понимать, показывать ли раздел с ключами. Чужие нет: перечень людей с
    // доступом сам по себе полезен тому, кто ищет, кого взламывать.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Записи создаются только руками в консоли. Иначе первый же вошедший
      // назначил бы админом себя, и список потерял бы смысл.
      allow write: if false;
    }

    // ---- всё остальное

    // Правило по умолчанию должно быть «нельзя»: забытая коллекция тогда
    // просто не работает, а не утекает.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
